    {
      "kind": "return",
      "items": [
        {
          "expression": {
            "kind": "prop",
            "object": {
              "kind": "var",
              "name": "hash"
            },
            "key": "value"
          },
          "alias": "md5"
        }
      ]
    }
  ]
