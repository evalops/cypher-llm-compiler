{
  "version": "cypher-llm-eval-dataset/v1",
  "name": "tool-hash-smoke",
  "description": "Small eval set covering identifier escaping, direction repair, and scope diagnostics.",
  "tasks": [
    {
      "id": "tool-md5-by-name",
      "question": "Find the MD5 hash value for the tool named test.py.",
      "source": "repo smoke fixture",
      "tags": ["identifier-escaping", "direction-repair"],
      "schema": {
        "version": "cypher-llm-schema/v1",
        "dialect": "neo4j-cypher-25",
        "nodes": [
          {
            "name": "Tool",
            "aliases": ["tool"],
            "properties": {
              "name": { "type": "STRING" }
            }
          },
          {
            "name": "Hash",
            "properties": {
              "value": { "type": "STRING" }
            }
          }
        ],
        "relationships": [
          {
            "type": "has MD5 hash",
            "aliases": ["md5"],
            "from": "Tool",
            "to": "Hash"
          }
        ],
        "parameters": {
          "toolName": {
            "type": "STRING",
            "required": true
          }
        }
      },
      "params": {
        "toolName": "test.py"
      },
      "expected": {
        "cypherContains": ["[:`has MD5 hash`]->", "LIMIT 25"],
        "repairKinds": ["canonicalize-identifier", "fix-direction", "add-limit"],
        "canExecute": true
      }
    },
    {
      "id": "tool-scope-drift",
      "question": "Return a tool after projecting a constant through WITH.",
      "source": "repo smoke fixture",
      "tags": ["scope-drift"],
      "schema": {
        "version": "cypher-llm-schema/v1",
        "dialect": "neo4j-cypher-25",
        "nodes": [
          {
            "name": "Tool",
            "properties": {
              "name": { "type": "STRING" }
            }
          }
        ],
        "relationships": []
      },
      "expected": {
        "diagnosticCodes": ["undefined-variable"],
        "canExecute": false
      }
    },
    {
      "id": "raw-spaced-relationship",
      "question": "Legacy raw Cypher attempt with an unescaped relationship type.",
      "source": "repo smoke fixture",
      "tags": ["raw-compatibility"],
      "schema": {
        "version": "cypher-llm-schema/v1",
        "dialect": "neo4j-cypher-25",
        "nodes": [
          { "name": "Tool" },
          { "name": "Hash" }
        ],
        "relationships": [
          {
            "type": "has MD5 hash",
            "from": "Tool",
            "to": "Hash"
          }
        ]
      },
      "expected": {
        "cypherContains": ["[:`has MD5 hash`]->"],
        "diagnosticCodes": ["raw-identifier-quoted"],
        "repairKinds": ["quote-raw-identifier"]
      }
    }
  ]
}
