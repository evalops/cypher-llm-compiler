{
  "name": "@evalops/cypher-llm-compiler",
  "version": "0.1.0",
  "description": "LLM-oriented Cypher IR, renderer, diagnostics, repair loop, and safety profile.",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "cypher-llm": "dist/src/cli.js",
    "cypher-llm-mcp": "dist/src/mcp-server.js"
  },
  "files": [
    "dist/src",
    "CHANGELOG.md",
    "README.md",
    "docker-compose.neo4j.yml",
    "docs",
    "examples",
    "profiles",
    "scripts",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:live:neo4j": "npm run build && node --test dist/test/neo4j-live.test.js",
    "neo4j:wait": "node scripts/wait-for-neo4j.mjs",
    "check": "npm run test",
    "verify:pack": "npm run build && npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "ajv": "^8.20.0",
    "neo4j-driver": "^6.0.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@neo4j-cypher/language-support": "^2.0.0-next.6",
    "csv-parse": "^6.2.1"
  }
}
