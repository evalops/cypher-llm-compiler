{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evalops.dev/schemas/cypher-llm/repair-plan/v1.json",
  "title": "Cypher Repair Plan",
  "type": "object",
  "required": [
    "version",
    "status",
    "cypherBefore",
    "cypherAfter",
    "deterministic",
    "modelRequired",
    "unsafe",
    "diagnostics",
    "policyEvidence",
    "summary"
  ],
  "additionalProperties": true,
  "properties": {
    "version": { "const": "cypher-llm-repair-plan/v1" },
    "status": { "enum": ["ready", "needs-model", "blocked"] },
    "cypherBefore": { "type": "string" },
    "cypherAfter": { "type": "string" },
    "deterministic": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" }
    },
    "modelRequired": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" }
    },
    "unsafe": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "policyEvidence": { "$ref": "#/$defs/policyEvidence" },
    "summary": {
      "type": "object",
      "required": ["deterministic", "modelRequired", "unsafe", "diagnostics"],
      "additionalProperties": false,
      "properties": {
        "deterministic": { "type": "integer", "minimum": 0 },
        "modelRequired": { "type": "integer", "minimum": 0 },
        "unsafe": { "type": "integer", "minimum": 0 },
        "sourceAnchored": { "type": "integer", "minimum": 0 },
        "diagnostics": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["id", "class", "rank", "title", "diagnostics", "rationale"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "class": { "enum": ["deterministic", "model-required", "unsafe"] },
        "rank": { "type": "integer" },
        "title": { "type": "string" },
        "path": { "type": "string" },
        "sourceAnchor": { "$ref": "#/$defs/sourceAnchor" },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "patch": {
          "type": "object",
          "required": ["op", "path", "value"],
          "additionalProperties": true,
          "properties": {
            "op": { "enum": ["add", "replace"] },
            "path": { "type": "string" },
            "value": {}
          }
        },
        "before": {},
        "after": {},
        "rationale": { "type": "string" }
      }
    },
    "sourceAnchor": {
      "type": "object",
      "required": ["sourcePath", "span", "text", "kind"],
      "additionalProperties": false,
      "properties": {
        "sourcePath": { "type": "string", "pattern": "^/" },
        "span": { "$ref": "#/$defs/span" },
        "text": { "type": "string" },
        "kind": { "enum": ["fragment", "statement", "clause", "trivia", "terminator"] },
        "sourceKind": { "type": "string", "minLength": 1 },
        "keyword": { "type": "string", "minLength": 1 },
        "support": { "enum": ["lifted", "raw", "unknown"] },
        "irPath": { "type": "string", "pattern": "^/" }
      }
    },
    "span": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "$ref": "#/$defs/position" },
        "end": { "$ref": "#/$defs/position" }
      }
    },
    "position": {
      "type": "object",
      "required": ["offset", "line", "character"],
      "additionalProperties": false,
      "properties": {
        "offset": { "type": "integer", "minimum": 0 },
        "line": { "type": "integer", "minimum": 0 },
        "character": { "type": "integer", "minimum": 0 }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "additionalProperties": true,
      "properties": {
        "code": { "type": "string" },
        "severity": { "enum": ["error", "warning", "info"] },
        "message": { "type": "string" },
        "path": { "type": "string" },
        "suggestion": { "type": "string" }
      }
    },
    "policyEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "ok", "summary", "findingCodes"],
      "properties": {
        "version": { "const": "cypher-llm-policy-evidence/v1" },
        "ok": { "type": "boolean" },
        "policy": { "type": "object", "additionalProperties": true },
        "rules": { "type": "object", "additionalProperties": true },
        "planner": { "type": "object", "additionalProperties": true },
        "statistics": { "type": "object", "additionalProperties": true },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["findings", "errors", "warnings", "infos"],
          "properties": {
            "findings": { "type": "integer", "minimum": 0 },
            "errors": { "type": "integer", "minimum": 0 },
            "warnings": { "type": "integer", "minimum": 0 },
            "infos": { "type": "integer", "minimum": 0 }
          }
        },
        "findingCodes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
