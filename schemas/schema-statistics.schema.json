{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evalops.dev/schemas/cypher-llm/schema-statistics/v1.json",
  "title": "Cypher Schema Statistics",
  "type": "object",
  "required": ["version", "source", "nodes", "relationships"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "cypher-llm-schema-statistics/v1" },
    "source": { "enum": ["neo4j-introspection", "manual", "fixture"] },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "count": { "type": "number", "minimum": 0 },
        "indexedProperties": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "relationship": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "count": { "type": "number", "minimum": 0 },
        "averageFanout": { "type": "number", "minimum": 0 }
      }
    }
  }
}
