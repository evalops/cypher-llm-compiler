{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evalops.dev/schemas/cypher-llm/dialect-certification/v1.json",
  "title": "Cypher LLM Dialect Certification Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "summary", "profiles"],
  "properties": {
    "version": { "const": "cypher-llm-dialect-certification/v1" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "summary": { "$ref": "#/$defs/summary" },
    "profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/profileReport" },
      "minItems": 1
    }
  },
  "$defs": {
    "status": { "enum": ["passed", "warning", "failed"] },
    "profileStatus": { "enum": ["stable", "preview", "experimental"] },
    "checkKind": { "enum": ["profile", "renderer", "semantic", "parser"] },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profiles",
        "passedProfiles",
        "warningProfiles",
        "failedProfiles",
        "checks",
        "passedChecks",
        "warningChecks",
        "failedChecks"
      ],
      "properties": {
        "profiles": { "type": "integer", "minimum": 0 },
        "passedProfiles": { "type": "integer", "minimum": 0 },
        "warningProfiles": { "type": "integer", "minimum": 0 },
        "failedProfiles": { "type": "integer", "minimum": 0 },
        "checks": { "type": "integer", "minimum": 0 },
        "passedChecks": { "type": "integer", "minimum": 0 },
        "warningChecks": { "type": "integer", "minimum": 0 },
        "failedChecks": { "type": "integer", "minimum": 0 }
      }
    },
    "profileReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "displayName", "profileStatus", "status", "checks"],
      "properties": {
        "profileId": { "enum": ["neo4j-cypher-25", "opencypher-9", "gql"] },
        "displayName": { "type": "string", "minLength": 1 },
        "profileStatus": { "$ref": "#/$defs/profileStatus" },
        "status": { "$ref": "#/$defs/status" },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/check" },
          "minItems": 1
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "status", "expected", "observed", "evidence", "diagnostics"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/checkKind" },
        "status": { "$ref": "#/$defs/status" },
        "expected": { "type": "string", "minLength": 1 },
        "observed": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "diagnostics": { "$ref": "#/$defs/stringList" },
        "cypher": { "type": "string", "minLength": 1 }
      }
    }
  }
}
