{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evalops.dev/schemas/cypher-llm/years-roadmap/v1.json",
  "title": "Cypher LLM Years Roadmap",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "thesis", "workstreams", "capabilities"],
  "properties": {
    "version": { "const": "cypher-llm-years-roadmap/v1" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "thesis": { "type": "string", "minLength": 1 },
    "workstreams": {
      "type": "array",
      "items": { "$ref": "#/$defs/workstream" },
      "minItems": 1
    },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" },
      "minItems": 1
    }
  },
  "$defs": {
    "status": {
      "enum": ["implemented", "partial", "planned"]
    },
    "workstreamStatus": {
      "enum": ["seeded", "active", "planned"]
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "url"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "pattern": "^https://github\\.com/.+/issues/[0-9]+$" }
      }
    },
    "workstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "horizon",
        "status",
        "issue",
        "thesis",
        "outcomes",
        "firstArtifacts",
        "acceptanceGates"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "horizon": { "const": "years" },
        "status": { "$ref": "#/$defs/workstreamStatus" },
        "issue": { "$ref": "#/$defs/issue" },
        "thesis": { "type": "string", "minLength": 1 },
        "outcomes": { "$ref": "#/$defs/stringList" },
        "firstArtifacts": { "$ref": "#/$defs/stringList" },
        "acceptanceGates": { "$ref": "#/$defs/stringList" },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "uniqueItems": true
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "evidence", "workstreamIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "evidence": { "$ref": "#/$defs/stringList" },
        "workstreamIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
