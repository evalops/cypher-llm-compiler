{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evalops.dev/schemas/cypher-llm/service-openapi/v1.json",
  "title": "Cypher Compiler Service OpenAPI Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "openapi", "info", "servers", "security", "summary", "paths", "components"],
  "properties": {
    "version": { "const": "cypher-llm-service-openapi/v1" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "openapi": { "const": "3.1.0" },
    "info": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "version", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "servers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "description"],
        "properties": {
          "url": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "security": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routes",
        "operations",
        "getRoutes",
        "postRoutes",
        "toolRoutes",
        "publicRoutes",
        "authenticatedRoutes",
        "maxBodyBytes"
      ],
      "properties": {
        "routes": { "type": "integer", "minimum": 1 },
        "operations": { "type": "integer", "minimum": 1 },
        "getRoutes": { "type": "integer", "minimum": 0 },
        "postRoutes": { "type": "integer", "minimum": 0 },
        "toolRoutes": { "type": "integer", "minimum": 0 },
        "publicRoutes": { "type": "integer", "minimum": 0 },
        "authenticatedRoutes": { "type": "integer", "minimum": 0 },
        "maxBodyBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "paths": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "get": { "$ref": "#/$defs/operation" },
          "post": { "$ref": "#/$defs/operation" }
        },
        "anyOf": [
          { "required": ["get"] },
          { "required": ["post"] }
        ]
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["securitySchemes", "schemas"],
      "properties": {
        "securitySchemes": {
          "type": "object",
          "required": ["bearerAuth"],
          "additionalProperties": true
        },
        "schemas": {
          "type": "object",
          "required": ["JsonObject", "ErrorResponse"],
          "additionalProperties": true
        }
      }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["operationId", "tags", "summary", "description", "responses"],
      "properties": {
        "operationId": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "summary": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "security": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "parameters": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "requestBody": {
          "type": "object",
          "additionalProperties": true
        },
        "responses": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["description"],
            "additionalProperties": true
          }
        }
      }
    }
  }
}
